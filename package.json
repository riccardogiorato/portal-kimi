{
  "name": "portal-kimi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A Portal 2-grade first-person puzzle game built with Babylon.js and TypeScript",
  "scripts": {
    "predev": "node scripts/copy-wasm.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-wasm.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@babylonjs/core": "^9.18.1",
    "@babylonjs/havok": "^1.3.14",
    "@babylonjs/loaders": "^9.18.1",
    "@babylonjs/materials": "^9.18.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
